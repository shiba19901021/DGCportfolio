---
import Base from '../../layouts/Base.astro';
import WorkRowCard from '../../components/WorkRowCard.astro';
import MiniCard from '../../components/MiniCard.astro';
import { listedWorks, pathFor } from '../../lib/works';
import { listedMinis, miniKinds } from '../../lib/minis';
import '../../styles/home-v03.css';
import '../../styles/home-editorial.css';
import '../../styles/works-index.css';
import '../../styles/minis.css';

const works = await listedWorks();
const minis = await listedMinis();
const miniGroups = (['practice', 'course'] as const)
  .map(kind => ({ kind, ...miniKinds[kind], items: minis.filter(mini => mini.data.kind === kind) }))
  .filter(group => group.items.length > 0);
const groups = [
  { id: 'projects', title: '代表專案', works: works.filter(work => work.data.category !== 'learning') },
  { id: 'courses', title: '代表課程', works: works.filter(work => work.data.category === 'learning') },
];
---
<Base title="所有作品｜游鏡騰" homeVisual>
  <div class="home-v03 home-editorial works-index wrap">
    <header class="works-index-heading"><h1>所有作品</h1></header>
    <div class="works-index-columns">
      {groups.map(group => <section class="home-work-group" aria-labelledby={`${group.id}-title`}>
        <div class="home-section-heading"><h2 id={`${group.id}-title`}>{group.title}</h2></div>
        <div class="home-work-list">{group.works.map(work => <WorkRowCard work={work} />)}</div>
      </section>)}
    </div>
    {miniGroups.length > 0 && <div id="minis" class="works-index-columns works-mini">
      {miniGroups.map(group => <section class="home-work-group" aria-labelledby={`mini-${group.kind}-title`}>
        <div class="home-section-heading"><h2 id={`mini-${group.kind}-title`}>{group.title}</h2></div>
        <p class="works-mini-note">{group.note}</p>
        <ul class="mini-list">{group.items.map(mini => <li><MiniCard mini={mini} /></li>)}</ul>
      </section>)}
    </div>}
    <div class="works-index-return"><a class="home-index-link" href={pathFor('/')}>← 返回首頁</a></div>
  </div>
</Base>
