---
import CasePage from '../../components/CasePage.astro';
import { listedWorks } from '../../lib/works';
export async function getStaticPaths() {
  const all = await listedWorks();
  return all.filter(w => w.data.detail).map(work => ({ params: { id: work.id }, props: { work, all } }));
}
const { work, all } = Astro.props;
---
<CasePage work={work} all={all} lang="zh" />
