---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WorkArt from '../../components/WorkArt.astro';
import RelatedWorks from '../../components/RelatedWorks.astro';
import { listedWorks, pathFor } from '../../lib/works';
import { categories } from '../../data/site';
import CaseModules from '../../components/case/CaseModules.astro';
import RainwaterModules from '../../components/case/RainwaterModules.astro';
import CaseFigure from '../../components/case/CaseFigure.astro';
import { visibleBlocks } from '../../lib/case-blocks';
import '../../styles/case-v03.css';
import '../../styles/case-v2.css';
import '../../styles/case-eco-kitchen.css';
import '../../styles/case-alishan.css';
import '../../styles/case-climate-program.css';
import '../../styles/case-food-carbon.css';
export async function getStaticPaths() {
  const all = await listedWorks();
  return all.filter(w => w.data.detail).map(work => ({ params: { id: work.id }, props: { work, all } }));
}
const { work, all } = Astro.props;
const { Content, headings } = await render(work);
const d = work.data;
const intro = d.detailIntro;
const parent = categories[d.category];
const blocks = visibleBlocks(work);
const modular = blocks.length > 0;
const rainwater = work.id === 'rainwater';
const ecoKitchen = work.id === 'eco-kitchen';
const alishan = work.id === 'alishan';
const climateProgram = work.id === 'climate-program';
const foodCarbon = work.id === 'food-carbon';
const caseV2 = rainwater || ecoKitchen || alishan || work.id === 'workflow' || climateProgram || foodCarbon;
---
<Base title={`${intro?.title ?? d.title}｜游鏡騰`} description={d.summary} activeCategory={d.category} previewVersion={intro ? "V0.7" : "V0.6"} caseVisual={caseV2}>
  {modular ? <div class:list={['case-v03', { 'case-v2': caseV2, 'case-eco-kitchen': ecoKitchen, 'case-alishan': alishan, 'case-climate-program': climateProgram, 'case-food-carbon': foodCarbon }]}>
    <header class="wrap case-v03-header"><nav aria-label="所在位置" class="breadcrumb"><a href={pathFor('/')}>首頁</a><span aria-hidden="true">／</span><a href={pathFor(parent.path)}>{parent.label}</a></nav>{!caseV2 && <p class="eyebrow">{parent.label} · 完整案例</p>}<h1>{intro?.title ?? d.title}</h1><p class="lead">{intro?.subtitle ?? d.summary}</p>{intro && <div class="case-reading"><p>{intro.introduction}</p></div>}<p class="case-header-role"><strong>我的角色：</strong>{d.role}</p>{d.image?.approved && <div class="case-hero-photo"><CaseFigure image={{ ...d.image, preview: false, annotations: [], ratio: 'wide', fit: 'cover', placeholder: '' }} eager /></div>}</header>
    {!caseV2 && blocks.some(block => block.title) && <nav class="wrap case-v03-toc" aria-label="案例內容"><ul>{blocks.filter(block => block.title).map(block => <li><a href={`#${block.id}`}>{block.title}</a></li>)}</ul></nav>}
    <article class="wrap case-modules">{rainwater ? <RainwaterModules work={work} /> : <CaseModules work={work}><Content slot="body" /></CaseModules>}</article>
    <div class="wrap case-v03-end"><RelatedWorks work={work} all={all} /><div class="case-next">{caseV2 ? <a class="text-link" href={pathFor('/works/')}>← 返回所有作品</a> : <><a class="text-link" href={pathFor(parent.path)}>← 回到{parent.label}</a><a class="text-link" href={pathFor('/explore/')}>從問題繼續探索 ↗</a></>}</div></div>
  </div> : <>
  <div class="wrap case-intro"><nav aria-label="所在位置" class="breadcrumb"><a href={pathFor('/')}>首頁</a><span aria-hidden="true">／</span><a href={pathFor(parent.path)}>{parent.label}</a></nav><p class="eyebrow">{parent.label} · 完整案例</p><h1>{d.title}</h1><p class="lead">{d.summary}</p><WorkArt id={work.id} /></div>
  <div class="wrap case-layout">
    <aside class="case-toc"><nav aria-label="案例內容"><h2>閱讀這個案例</h2><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></aside>
    <article class="prose">
      <section class="snapshot" aria-labelledby="snapshot-title"><h2 id="snapshot-title">專案概要</h2><dl class="evidence-list"><div><dt>原始問題</dt><dd>{d.challenge}</dd></div><div><dt>我的角色</dt><dd>{d.role}</dd></div><div><dt>完成內容</dt><dd>{d.delivered}</dd></div><div class="boundary"><dt>成果說明與限制</dt><dd>{d.boundary}</dd></div></dl></section>
      <Content />
      <RelatedWorks work={work} all={all} />
      <div class="case-next"><a class="text-link" href={pathFor(parent.path)}>← 回到{parent.label}</a><a class="text-link" href={pathFor('/explore/?problem=iterate')}>從測試與修正繼續探索 ↗</a></div>
    </article>
  </div>
  </>}
</Base>



