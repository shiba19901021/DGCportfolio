---
import Base from '../layouts/Base.astro';
import WorkRowCard from '../components/WorkRowCard.astro';
import WorkCompactRow from '../components/WorkCompactRow.astro';
import { listedWorks, pathFor } from '../lib/works';
import { site } from '../data/site';
import { homeSummaries, homeFeatured } from '../data/home-summaries';
import '../styles/home-v03.css';
import '../styles/home-editorial.css';
import '../styles/home-summaries.css';
const works = await listedWorks();
const projects = works.filter(work => work.data.category !== 'learning');
const courses = works.filter(work => work.data.category === 'learning');
const featured = new Set(homeFeatured);
const projectCards = projects.filter(work => featured.has(work.id));
const projectRows = projects.filter(work => !featured.has(work.id));
const courseCards = courses.filter(work => featured.has(work.id));
const courseRows = courses.filter(work => !featured.has(work.id));
---
<Base homeVisual>
  <div class="home-v03 home-editorial">
    <section class="home-hero wrap" aria-labelledby="home-title">
      <h1 id="home-title">{site.slogan}</h1>
      <p class="home-position">我是游鏡騰，方案設計者。從永續實務與環境教育出發，擅長拆解複雜問題、整合現有資源，設計成能實際運作、並依結果修正的方案。</p>
      <p class="home-directions"><span>氣候韌性與永續方案</span>｜<span>跨領域專案</span>｜<span>系統與流程改善</span>｜<span>遠端／彈性工作</span></p>
      <div class="home-actions"><a class="home-index-link" href={pathFor('/works/')}>所有作品 <span aria-hidden="true">↓</span></a></div>
      <section class="home-professional" aria-labelledby="professional-title">
        <h2 id="professional-title">專業履歷</h2>
        <div class="home-resume-directions">
        <a class="work-row resume-direction" href={pathFor('/resume/')}>
          <div class="work-row-copy"><h3>方案設計與問題解決</h3><p>跨領域專案、方案研發、系統與流程改善</p></div>
          <span class="work-row-link"><span class="work-row-arrow" aria-hidden="true">↗</span></span>
        </a>
        <a class="work-row resume-direction" href={pathFor('/teaching/')}>
          <div class="work-row-copy"><h3>課程設計與教學合作</h3><p>課程研發、教材設計、體驗式教學與教師研習</p></div>
          <span class="work-row-link"><span class="work-row-arrow" aria-hidden="true">↗</span></span>
        </a>
        </div>
      </section>
    </section>

    <div id="works" class="home-works">
      <section id="selected" class="home-work-group wrap" aria-labelledby="projects-title">
        <div class="home-section-heading"><div><h2 id="projects-title">專案作品</h2><p>從問題、限制到執行與修正，閱讀完整的專案脈絡。</p></div></div>
        <div class="home-work-list">{projectCards.map(work => <WorkRowCard work={work} summary={homeSummaries[work.id]} />)}</div>
        {projectRows.length > 0 && <div class="home-work-list home-work-list-compact">{projectRows.map(work => <WorkCompactRow work={work} />)}</div>}
      </section>
      <section class="home-work-group wrap" aria-labelledby="courses-title">
        <div class="home-section-heading"><div><h2 id="courses-title">課程作品</h2><p>探索學習流程、互動機制，以及試教與回饋如何推進設計。</p></div></div>
        <div class="home-work-list">{courseCards.map(work => <WorkRowCard work={work} summary={homeSummaries[work.id]} />)}</div>
        {courseRows.length > 0 && <div class="home-work-list home-work-list-compact">{courseRows.map(work => <WorkCompactRow work={work} />)}</div>}
      </section>
      <div class="home-all-works wrap"><a class="home-index-link" href={pathFor('/works/')}>查看所有作品 <span aria-hidden="true">↗</span></a></div>
    </div>

    <section id="about" class="home-about" aria-labelledby="about-title">
      <div class="wrap home-about-grid"><div><h2 id="about-title">關於我</h2><p class="home-about-direction">從現場經驗，走向下一個方案。</p><p>我的背景涵蓋環境教育、永續實務、場域建置與跨組織合作。希望將累積的問題分析與方案設計經驗，應用到更廣泛的工作。</p><p class="home-work-preference">偏好遠端或彈性工作，可配合必要場勘與現場協作。</p></div>
      <div id="resume" class="home-resume"><h2>聯絡方式</h2><p>歡迎跨領域方案設計、課程研發、教學及專案合作邀約。</p><div class="home-contact-list"><a href={`mailto:${site.email}`}>Email 聯絡 <span aria-hidden="true">↗</span></a><a href={site.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></div></div></div>
    </section>
  </div>
</Base>
