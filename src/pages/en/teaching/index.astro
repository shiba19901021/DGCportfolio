---
import Base from '../../../layouts/Base.astro';
import ResumeDocument from '../../../components/ResumeDocument.astro';
import teaching from '../../../data/teaching.en.json';
import { pathFor } from '../../../lib/works';
import '../../../styles/resume.css';
import '../../../styles/teaching.css';
import '../../../styles/teaching-en.css';
import '../../../styles/en-print.css';
---
<Base lang="en" alt="/teaching/" title={`Ching-Teng Yu | Resume: Course Design and Teaching Collaboration`} description={teaching.summary}>
