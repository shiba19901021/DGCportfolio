---
import MiniPage from '../../components/MiniPage.astro';
import { listedMinis } from '../../lib/minis';
export async function getStaticPaths() {
  const all = await listedMinis();
  return all.map(mini => ({ params: { id: mini.id }, props: { mini } }));
}
const { mini } = Astro.props;
---
<MiniPage mini={mini} lang="zh" />
