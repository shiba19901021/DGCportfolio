---
import type { CaseBlock } from '../../data/case-blocks';
import type { Work } from '../../lib/works';
import { caseText } from '../../lib/case-blocks';
interface Props { block: Extract<CaseBlock, { type: 'results' }>; work: Work; }
const { block, work } = Astro.props;
const groups = block.groups.map(group => ({ label: group.label, items: group.items.map(item => caseText(item, work)).filter(Boolean) })).filter(group => group.label.trim() && group.items.length);
---
{groups.length > 0 && <section id={block.id} class="case-block case-results" data-module="results">
  {block.title && <h2>{block.title}</h2>}
  <dl>{groups.map(group => <div><dt>{group.label}</dt><dd>{group.items.length === 1 ? <p>{group.items[0]}</p> : <ul>{group.items.map(text => <li>{text}</li>)}</ul>}</dd></div>)}</dl>
</section>}
