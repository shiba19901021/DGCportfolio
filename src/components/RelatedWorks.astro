---
import type { Work } from '../lib/works';
import { workHref } from '../lib/works';
interface Props { work: Work; all: Work[]; }
const { work, all } = Astro.props;
const related = work.data.related.flatMap(r => {
  const target = all.find(w => w.id === r.id);
  return target ? [{ work: target, reason: r.reason }] : [];
});
---
{related.length > 0 && <aside class="related" aria-label={`${work.data.title}的相關作品`}>
  <h3>接著探索</h3>
  <ul>{related.map(r => <li><a href={workHref(r.work)}>{r.work.data.title}</a><p>{r.reason}</p></li>)}</ul>
</aside>}
