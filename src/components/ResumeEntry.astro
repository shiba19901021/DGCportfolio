---
import { pathFor } from '../lib/works';
---
<details class="resume-entry">
  <summary>履歷與合作<span aria-hidden="true">⌃</span></summary>
  <nav class="resume-menu" aria-label="履歷與合作選項">
    <a href={pathFor('/resume/')}>方案設計與問題解決<span aria-hidden="true">↗</span></a>
    <a href={pathFor('/teaching/')}>課程設計與教學合作<span aria-hidden="true">↗</span></a>
  </nav>
</details>
<style>
  .resume-entry { position: fixed; z-index: 20; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); }
  .resume-entry summary, .resume-entry a { display: flex; align-items: center; justify-content: space-between; gap: .65rem; min-height: 44px; padding: .65rem 1rem; background: #F7F5F0; color: #292E32; font-family: system-ui, sans-serif; font-size: .875rem; font-weight: 600; line-height: 1.5; text-decoration: none; }
  .resume-entry summary { border: 1px solid #B9784F; border-radius: 3px; cursor: pointer; list-style: none; }
  .resume-entry summary::-webkit-details-marker { display: none; }
  .resume-menu { display: none; position: absolute; bottom: calc(100% + .5rem); right: 0; width: min(20rem, calc(100vw - 2rem)); max-height: calc(100dvh - 6rem); overflow-y: auto; padding: .35rem; border: 1px solid #B9784F; border-radius: 3px; background: #F7F5F0; }
  .resume-entry[open] .resume-menu { display: grid; }
  .resume-entry span { color: #864e29; }
  .resume-entry a:hover, .resume-entry summary:hover { background: #eee9e0; }
  .resume-entry a:focus-visible, .resume-entry summary:focus-visible { outline: 3px solid #864e29; outline-offset: 3px; }
  @media print { .resume-entry { display: none; } }
</style>
