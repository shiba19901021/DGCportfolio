---
import type { Work } from '../lib/works';
import { pathFor, workHref, workLinkLabel } from '../lib/works';
interface Props { work: Work; index: number; }
const { work, index } = Astro.props;
const d = work.data;
const learning = d.category === 'learning';
---
<article id={d.detail ? work.id : `project-${work.id}`} class="project-index-card" data-project={work.id}>
  <div class="project-index-media">
    {d.image?.approved ? <img src={pathFor(d.image.src)} alt={d.image.alt} loading="lazy" width="960" height="540" style={{ objectPosition: d.image.position }} /> : <div class="project-index-placeholder"><span class="project-index-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><span>{d.topics.slice(0, 2).join(' ／ ')}</span><small>{learning ? '課程或教具圖片尚未加入' : '專案照片尚未加入'}</small></div>}
  </div>
  <div class="project-index-copy">{d.image?.approved && d.image.caption && <p class="project-index-caption">{d.image.caption}</p>}<h2>{d.title}</h2><p class="project-index-challenge">{d.challenge}</p>{learning && <p class="project-index-feature"><strong>設計方式：</strong>{d.decision}</p>}<p class="project-index-outcome">{learning && <strong>完成內容：</strong>}{d.delivered}</p><ul class="tags" aria-label="主題">{d.topics.slice(0, 2).map(tag => <li>{tag}</li>)}</ul><a class="text-link" href={workHref(work)}>{workLinkLabel(work)}<span class="sr-only">：{d.title}</span> →</a></div>
</article>
