---
// 簡單線條圖案，替代照片。目前只有問卷；新增時在此加一個 name。
interface Props { name: 'questionnaire' | 'simulator'; }
const { name } = Astro.props;
---
{name === 'questionnaire' && <svg viewBox="0 0 92 69" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <rect x="14" y="13" width="28" height="40" rx="3" />
  <rect x="19" y="20" width="5" height="5" rx="1" /><path d="M20 22.5l1.5 1.5 2.5-3" class="mini-icon-accent" />
  <path d="M28 22.5h9" />
  <rect x="19" y="29.5" width="5" height="5" rx="1" /><path d="M28 32h9" />
  <rect x="19" y="39" width="5" height="5" rx="1" /><path d="M28 41.5h9" />
  <path d="M47 33h10M54 29.5l3.5 3.5-3.5 3.5" class="mini-icon-accent" />
  <rect x="61" y="19" width="18" height="28" rx="2" />
  <path d="M61 28.5h18M61 38h18M70 19v28" />
</svg>}
{name === 'simulator' && <svg viewBox="0 0 92 69" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <rect x="20" y="12" width="52" height="45" rx="3" />
  <path d="M46 12c-6 11 6 19 0 29s-4 13-2 16" class="mini-icon-accent" />
  <rect x="27" y="35" width="9" height="8" /><path d="M25 35l6.5-7 6.5 7" />
  <rect x="53" y="20" width="14" height="10" /><path d="M53 25h14" />
  <circle cx="59.500" cy="44" r="4" /><path d="M59.500 48v5" />
</svg>}
