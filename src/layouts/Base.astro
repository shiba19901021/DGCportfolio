---
import '../styles/global.css';
import '../styles/site-chrome.css';
import { site } from '../data/site';
import { pathFor } from '../lib/works';
interface Props { title?: string; description?: string; activeCategory?: string; previewVersion?: string; homeVisual?: boolean; }
const { title = site.title, description = site.positioning, previewVersion = 'V0.6', homeVisual = false } = Astro.props;
const publicRelease = import.meta.env.PORTFOLIO_PUBLIC_ONLY === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '');
const links = [
  { href: '/', label: '首頁', active: current === '/' },
  { href: '/#works', label: '所有作品', active: false },
  { href: '/#about', label: '關於我', active: false },
];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {!publicRelease && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={homeVisual ? '#fbf9f4' : '#f4f1e7'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400..700;1,400..700&amp;family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&amp;display=swap" rel="stylesheet" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body class:list={{ 'home-page': homeVisual }}>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <header class="site-header site-chrome-header">
      <div class="site-chrome-inner wrap">
      <a class="brand" href={pathFor('/')} aria-label="游鏡騰，回到首頁">游鏡騰<span>方案設計與實作</span></a>
      <nav aria-label="主要導覽"><ul>{links.map(link => <li><a href={pathFor(link.href)} aria-current={link.active ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer site-chrome-footer">
      <div class="site-chrome-inner wrap">
      <p>{site.positioning}</p>
      {!publicRelease && <p class="preview-label">{previewVersion} · 本機閱讀測試版</p>}
      </div>
    </footer>
  </body>
</html>



