---
import '../styles/global.css';
import { site } from '../data/site';
import { pathFor } from '../lib/works';
interface Props { title?: string; description?: string; activeCategory?: string; previewVersion?: string; }
const { title = site.title, description = site.positioning, activeCategory, previewVersion = 'V0.6' } = Astro.props;
const publicRelease = import.meta.env.PORTFOLIO_PUBLIC_ONLY === '1';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '');
const links = [
  { href: '/projects/', label: '專案作品集', active: current.startsWith('/projects') || (activeCategory !== undefined && activeCategory !== 'learning') },
  { href: '/learning/', label: '課程與教學設計', active: current.startsWith('/learning') || activeCategory === 'learning' },
  { href: '/explore/', label: '從問題探索', active: current.startsWith('/explore') },
  { href: '/#about', label: '關於與聯絡', active: false },
];
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {!publicRelease && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f4f1e7" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳至主要內容</a>
    <header class="site-header wrap">
      <a class="brand" href={pathFor('/')} aria-label="游鏡騰，回到首頁">游鏡騰<span>方案設計與實作</span></a>
      <nav aria-label="主要導覽"><ul>{links.map(link => <li><a href={pathFor(link.href)} aria-current={link.active ? 'page' : undefined}>{link.label}</a></li>)}</ul></nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer wrap">
      <div><p class="footer-name">游鏡騰</p><p>{site.positioning}</p></div>
      <div class="footer-links"><a href={`mailto:${site.email}`}>Email 聯絡</a><a href={site.linkedin}>LinkedIn</a><a href={pathFor('/#resume')}>履歷與經歷</a></div>
      {!publicRelease && <p class="preview-label">{previewVersion} · 本機閱讀測試版</p>}
    </footer>
  </body>
</html>



